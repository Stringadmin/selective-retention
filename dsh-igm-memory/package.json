{
  "name": "dsh-igm-memory",
  "version": "0.5.0",
  "description": "Typed, importance-gated and guarded memory tools for DeepSeek Harness with project isolation, versioned slot supersede, recall_history and a write-time trust boundary",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "scripts",
    "test",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "memory",
    "igm",
    "rag"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/test_igm_plugin.mjs",
    "benchmark": "node --expose-gc scripts/benchmark_igm_store.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "schemastery": "3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "license": "MIT"
}
